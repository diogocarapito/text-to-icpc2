# DOMAIN and ACME_EMAIL come from deploy/.env (docker compose passes them in).
{
	email {$ACME_EMAIL}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}
	# no access log: keep IP addresses out of the server's records
	reverse_proxy app:8000 {
		transport http {
			read_timeout 300s
		}
	}
}
